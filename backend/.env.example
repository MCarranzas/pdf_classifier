PROJECT_NAME=PDF Classifier API
VERSION=1.0.0

# MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pdf_classifier

# Orígenes permitidos (JSON list). En producción: el dominio del frontend.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# JWT: genera uno random, NUNCA uses el valor de ejemplo
JWT_SECRET=cambia-esto-por-un-secreto-random-de-32-caracteres-minimo
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Clasificador por IA (opcional). "disabled" usa solo keywords.
AI_PROVIDER=disabled
AI_BASE_URL=https://opencode.ai/zen/v1
AI_MODEL=big-pickle
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=6000
AI_FALLBACK_TO_KEYWORDS=true